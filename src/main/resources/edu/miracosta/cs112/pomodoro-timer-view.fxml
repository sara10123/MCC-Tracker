<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox alignment="CENTER" prefHeight="400" prefWidth="600" spacing="20.0" VBox.vgrow="ALWAYS" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.miracosta.cs112.controllers.PomodoroTimerController">
    <padding>
        <Insets bottom="40.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 36px; -fx-font-weight: bold;" text="Pomodoro Timer" />

    <Label fx:id="sessionLabel" style="-fx-font-size: 24px; " text="Work" />

    <StackPane>
        <Circle fill="#080808" radius="120" />

        <Label fx:id="timeLabel" style="-fx-font-size: 48px; -fx-font-weight: bold;" text="25:00" textFill="#efeaea" />
    </StackPane>

    <HBox alignment="CENTER" spacing="10">
        <Button fx:id="startButton" prefHeight="50" prefWidth="120" text="Start" onAction="#startTimer" />
        <Button fx:id="pauseButton" prefHeight="50" prefWidth="120" text="Pause" onAction="#pauseTimer" visible="false" managed="false" />
        <Button fx:id="resumeButton" prefHeight="50" prefWidth="120" text="Resume" onAction="#resumeTimer" visible="false" managed="false" />
        <Button fx:id="resetButton" prefHeight="50" prefWidth="120" text="Reset" onAction="#resetTimer" visible="false" managed="false" />

    </HBox>



</VBox>
